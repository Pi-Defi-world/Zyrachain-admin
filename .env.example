# Copy to .env.local for local development (never commit real secrets).
# Vite exposes only variables prefixed with VITE_ to the browser.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Base URL of the Zyrachain server (the API). No trailing slash.
# Production example: https://api.zyrachain.app
VITE_API_BASE_URL=http://localhost:4000

# Default admin email pre-filled on the login screen.
# Only whitelisted server-side emails can log in (ALLOWED_ADMIN_EMAILS in
# Zyrachain-server/zyrachain-lib/lib/email-service.ts).
VITE_ADMIN_EMAIL=zyrachains@gmail.com

# Default role pre-selected on the login screen.
# Accepted by the server: super_admin | admin | moderator
VITE_ADMIN_ROLE=super_admin

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# App title shown in the sidebar/header.
VITE_APP_TITLE=Zyrachain Admin

# Base path for hosted assets.
# - Custom domain / Vercel / root hosting: leave as '/'
# - GitHub Pages project site (no custom domain): '/Zyrachain-admin/'
VITE_BASE_PATH=/

# Custom domain for GitHub Pages (goes into the public/CNAME file on deploy).
# Example: admin.zyrachain.app
VITE_CUSTOM_DOMAIN=

# Timeout (ms) for API requests.
VITE_API_TIMEOUT=30000

# OTP request rate-limit hint (seconds) shown on the login screen.
VITE_OTP_RETRY_HINT=60

# ---------------------------------------------------------------------------
# NOT required by the admin app (server-side only, listed for reference)
# ---------------------------------------------------------------------------
# SERVER_PORT=4000
# MONGODB_URI=mongodb://localhost:27017/Zyrachain
# JWT_SECRET=keep-matching-the-server
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM  (needed so the
#   server can actually send the OTP email)
# FRONTEND_URL=http://localhost:8000